    }
  },
  "toleranceDeg": {
    "value": 14,
    "source": "hancock2018",
    "finding": "Visual estimation and a short-arm goniometer could only tell knee angles apart when they differed by about 14 deg (1.96 x SD), so smaller gaps from the reference rep are not cued."
  },
  "homeReps": {
    "value": 8,
    "source": "acsm2009",
    "finding": "For novices the ACSM recommends loads matching an 8-12 repetition range; the demo uses the low end."
  },
  "emergencyNumber": {
    "value": "123",
    "source": "egyptAmbulance",
    "finding": "Egypt's ambulance number. The app shows it; it never dials."
  },
